package views

// =============================================================================
// LAYOUTS BASE: ESTRUCTURA HTML GLOBAL (layout.templ)
// =============================================================================
// Contiene dos layouts:
// 1. LayoutAuth: Para vistas sin sesión activa (Login y Registro). No incluye
//    la barra de navegación del dashboard para evitar accesos sin sesión.
// 2. LayoutBase: Dashboard principal con barra de navegación superior para
//    las vistas autenticadas (Usuario, Calendario y Materias).
// =============================================================================

templ LayoutAuth(titulo string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ titulo }</title>
			<!-- Google Fonts: Caveat (marca) & Inter (cuerpo) -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
			<!-- FontAwesome Icons -->
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
			<!-- Hoja de estilos CSS nativa (servida desde /css/style.css) -->
			<link rel="stylesheet" href="/css/style.css"/>
		</head>
		<body>
			{ children... }
		</body>
	</html>
}

templ LayoutBase(titulo string, usuarioActivo string, activeTab string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ titulo }</title>
			<!-- Google Fonts: Caveat (marca) & Inter (cuerpo) -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
			<!-- FontAwesome Icons -->
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
			<!-- Hoja de estilos CSS nativa (servida desde /css/style.css) -->
			<link rel="stylesheet" href="/css/style.css"/>
		</head>
		<body>
			<!-- Barra de Navegación Superior del Dashboard -->
			<header class="site-header">
				<div class="header-container">
					<div class="brand-wrapper">
						<a href="/calendario" class="brand-logo brand-glow">go_tasks</a>
						if usuarioActivo != "" {
							<span class="user-badge">
								<i class="fa-solid fa-circle-user"></i>
								<span>{ usuarioActivo }</span>
							</span>
						}
					</div>

					<!-- Pestañas de Navegación entre Vistas -->
					<nav class="nav-tabs">
						<a href="/usuario" class={ "nav-tab", templ.KV("active", activeTab == "usuario") }>
							<i class="fa-solid fa-user"></i>
							<span>Usuario</span>
						</a>
						<a href="/calendario" class={ "nav-tab", templ.KV("active", activeTab == "calendario") }>
							<i class="fa-solid fa-calendar-days"></i>
							<span>Calendario</span>
						</a>
						<a href="/materias" class={ "nav-tab", templ.KV("active", activeTab == "materias") }>
							<i class="fa-solid fa-table-columns"></i>
							<span>Materias</span>
						</a>
						<a href="/logout" class="nav-tab" title="Cerrar Sesión">
							<i class="fa-solid fa-right-from-bracket"></i>
							<span>Salir</span>
						</a>
					</nav>
				</div>
			</header>

			<!-- Contenedor principal donde se inyecta el contenido de cada página -->
			<main class="main-wrapper">
				{ children... }
			</main>
		</body>
	</html>
}
