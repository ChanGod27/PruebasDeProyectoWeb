package views

// =============================================================================
// LAYOUTS BASE: ESTRUCTURA HTML GLOBAL
// =============================================================================


templ LayoutAuth(titulo string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ titulo }</title>
			<!-- Google Fonts: Caveat (marca) & Inter (cuerpo) -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
			<!-- FontAwesome Icons -->
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
			<!-- Hoja de estilos CSS nativa (servida desde /css/style.css) -->
			<link rel="stylesheet" href="/css/style.css"/>
			<!-- HTMX -->
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body>
			<div id="auth-content" style="flex: 1; display: flex; flex-direction: column;">
				{ children... }
			</div>
		</body>
	</html>
}

templ LayoutBase(titulo string, usuarioActivo string, activeTab string) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ titulo }</title>
			<!-- Google Fonts: Caveat (marca) & Inter (cuerpo) -->
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
			<!-- FontAwesome Icons -->
			<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
			<!-- Hoja de estilos CSS nativa (servida desde /css/style.css) -->
			<link rel="stylesheet" href="/css/style.css"/>
			<!-- HTMX -->
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body>
			<!-- Barra de Navegación Superior del Dashboard (persistente entre vistas HTMX) -->
			<header class="site-header">
				<div class="header-container">
					<div class="brand-wrapper">
						<a
							href="/calendario"
							hx-get="/calendario"
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
							class="brand-logo brand-glow"
						>go_tasks</a>
						if usuarioActivo != "" {
							<span class="user-badge">
								<i class="fa-solid fa-circle-user"></i>
								<span>{ usuarioActivo }</span>
							</span>
						}
					</div>

					<!-- Pestañas de Navegación entre Vistas -->
					<nav class="nav-tabs">
						<a
							href="/usuario"
							hx-get="/usuario"
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
							data-tab="usuario"
							class={ "nav-tab", templ.KV("active", activeTab == "usuario") }
						>
							<i class="fa-solid fa-user"></i>
							<span>Usuario</span>
						</a>
						<a
							href="/calendario"
							hx-get="/calendario"
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
							data-tab="calendario"
							class={ "nav-tab", templ.KV("active", activeTab == "calendario") }
						>
							<i class="fa-solid fa-calendar-days"></i>
							<span>Calendario</span>
						</a>
						<a
							href="/materias"
							hx-get="/materias"
							hx-target="#main-content"
							hx-swap="innerHTML"
							hx-push-url="true"
							data-tab="materias"
							class={ "nav-tab", templ.KV("active", activeTab == "materias") }
						>
							<i class="fa-solid fa-table-columns"></i>
							<span>Materias</span>
						</a>
						<a href="/logout" class="nav-tab" title="Cerrar Sesión">
							<i class="fa-solid fa-right-from-bracket"></i>
							<span>Salir</span>
						</a>
					</nav>
				</div>
			</header>

			<!-- Contenedor principal donde HTMX inyecta el fragmento de cada vista -->
			<main id="main-content" class="main-wrapper">
				{ children... }
			</main>

			<!-- Sincroniza la pestaña activa del navbar al navegar con HTMX o historial -->
			<script>
				(function() {
					function syncActiveTab() {
						const path = window.location.pathname;
						document.querySelectorAll(".nav-tabs .nav-tab[data-tab]").forEach(function(tab) {
							const href = tab.getAttribute("href");
							tab.classList.toggle("active", path === href);
						});
					}
					document.body.addEventListener("htmx:pushedIntoHistory", syncActiveTab);
					window.addEventListener("popstate", syncActiveTab);
				})();
			</script>
		</body>
	</html>
}
