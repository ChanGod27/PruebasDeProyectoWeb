package views

import (
	"ServidorEntregable/db"
	"fmt"
	"github.com/jackc/pgx/v5/pgtype"
)

// =============================================================================
// VISTA DE MATERIAS Y TAREAS 
// =============================================================================


type MateriaConTareas struct {
	Materia db.ListaTarea
	Tareas  []db.Tarea
}

func tareasPendientes(tareas []db.Tarea) []db.Tarea {
	var res []db.Tarea
	for _, t := range tareas {
		if !t.Completada {
			res = append(res, t)
		}
	}
	return res
}

func tareasCompletadas(tareas []db.Tarea) []db.Tarea {
	var res []db.Tarea
	for _, t := range tareas {
		if t.Completada {
			res = append(res, t)
		}
	}
	return res
}

func formatFecha(ts pgtype.Timestamp) string {
	if !ts.Valid {
		return ""
	}
	return ts.Time.Format("02/01 15:04")
}

func formatFechaInput(ts pgtype.Timestamp) string {
	if !ts.Valid {
		return ""
	}
	return ts.Time.Format("2006-01-02T15:04")
}

templ MateriasContent(materias []MateriaConTareas) {
	<!-- Encabezado de la Sección -->
	<section class="page-header">
		<h1 class="page-title brand-glow">go_tasks</h1>
		<div class="page-subtitle">
			<i class="fa-solid fa-table-columns"></i>
			<span>Tablero de Materias y Tareas</span>
		</div>
	</section>

	<!-- Barra de Acciones: Agregar Materia / Agregar Tarea -->
	<section class="action-bar">
		<div style="color: var(--color-text-muted); font-size: 0.9rem; font-weight: 500;">
			<i class="fa-solid fa-layer-group" style="color: var(--color-primary); margin-right: 0.4rem;"></i>
			<span>{ fmt.Sprint(len(materias)) } materias registradas</span>
		</div>
		<div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
			<a href="#materia-modal" class="btn btn-outline">
				<i class="fa-solid fa-folder-plus"></i>
				<span>Agregar Materia</span>
			</a>
			<a href="#task-modal" class="btn btn-primary">
				<i class="fa-solid fa-plus"></i>
				<span>Agregar Tarea</span>
			</a>
		</div>
	</section>

	<!-- Tablero de Materias -->
	if len(materias) == 0 {
		<div class="empty-state-card">
			<i class="fa-solid fa-book-open empty-state-icon"></i>
			<h3 class="empty-state-title">No tienes materias creadas</h3>
			<p class="empty-state-desc">
				Crea tu primera materia para comenzar a organizar tus tareas, fechas límite y horas de estudio.
			</p>
			<div style="margin-top: 1.5rem;">
				<a href="#materia-modal" class="btn btn-primary">
					<i class="fa-solid fa-folder-plus"></i>
					<span>Agregar Primera Materia</span>
				</a>
			</div>
		</div>
	} else {
		<section class="kanban-board">
			<div class="kanban-columns" style="grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));">
				for _, m := range materias {
					<article class="kanban-col">
						<div class="kanban-col-top">
							<!-- Cabecera de la Materia -->
							<header class="kanban-col-header">
								<div class="kanban-col-title">
									<i class="fa-solid fa-book col-icon-amber"></i>
									<span>{ m.Materia.Titulo }</span>
								</div>
								<div style="display: flex; align-items: center; gap: 0.4rem;">
									<span class="badge badge-amber">
										{ fmt.Sprint(len(tareasPendientes(m.Tareas))) } pendientes
									</span>
									<a
										href={ templ.URL(fmt.Sprintf("#edit-materia-%d", m.Materia.IDLista)) }
										title="Editar materia"
										style="color: var(--color-text-muted); font-size: 0.8rem; padding: 0.15rem 0.25rem; text-decoration: none;"
									>
										<i class="fa-solid fa-pen"></i>
									</a>
									<button
										type="button"
										hx-delete={ fmt.Sprintf("/materias/%d", m.Materia.IDLista) }
										hx-target="#main-content"
										hx-swap="innerHTML"
										hx-confirm="¿Eliminar esta materia junto con todas sus tareas?"
										title="Eliminar materia"
										style="background: transparent; border: none; color: #f87171; cursor: pointer; font-size: 0.8rem; padding: 0.15rem 0.25rem;"
									>
										<i class="fa-solid fa-trash-can"></i>
									</button>
								</div>
							</header>

							<!-- Lista de Tareas Pendientes -->
							<div class="kanban-task-list">
								if len(tareasPendientes(m.Tareas)) == 0 {
									<div class="kanban-empty-state">
										<i class="fa-regular fa-circle-check empty-icon" style="color: var(--color-green);"></i>
										<span class="empty-title">Sin tareas pendientes</span>
										<span class="empty-desc">Agrega una nueva tarea o revisa las completadas abajo.</span>
									</div>
								} else {
									for _, t := range tareasPendientes(m.Tareas) {
										<div class="task-card">
											<div class="task-card-header">
												<div class="task-name-group">
													<span class="task-red-ring"></span>
													<span class="task-title">{ t.Titulo }</span>
												</div>
												<div style="display: flex; align-items: center; gap: 0.4rem;">
													if t.FechaFinalizacion.Valid {
														<span class="badge badge-blue">
															<i class="fa-regular fa-clock"></i> { formatFecha(t.FechaFinalizacion) }
														</span>
													}
													<a
														href={ templ.URL(fmt.Sprintf("#edit-task-%d", t.IDTarea)) }
														title="Editar tarea"
														style="color: var(--color-text-muted); font-size: 0.78rem; padding: 0.1rem 0.2rem; text-decoration: none;"
													>
														<i class="fa-solid fa-pen"></i>
													</a>
													<button
														type="button"
														hx-delete={ fmt.Sprintf("/tareas/%d", t.IDTarea) }
														hx-target="#main-content"
														hx-swap="innerHTML"
														hx-confirm="¿Eliminar esta tarea?"
														title="Eliminar tarea"
														style="background: transparent; border: none; color: #f87171; cursor: pointer; font-size: 0.78rem; padding: 0.1rem 0.2rem;"
													>
														<i class="fa-solid fa-trash-can"></i>
													</button>
												</div>
											</div>

											if t.Descripcion.Valid && t.Descripcion.String != "" {
												<p style="font-size: 0.78rem; color: var(--color-text-muted); line-height: 1.4;">
													{ t.Descripcion.String }
												</p>
											}

											<!-- Checklist HTMX para completar la tarea -->
											<form
												action={ templ.URL(fmt.Sprintf("/tareas/%d/completar", t.IDTarea)) }
												method="POST"
												hx-post={ fmt.Sprintf("/tareas/%d/completar", t.IDTarea) }
												hx-target="#main-content"
												hx-swap="innerHTML"
												class="task-checklist"
											>
												<label class="checklist-label">
													<input
														type="checkbox"
														class="checklist-input"
														hx-trigger="change"
														hx-post={ fmt.Sprintf("/tareas/%d/completar", t.IDTarea) }
														hx-target="#main-content"
														hx-swap="innerHTML"
													/>
													<span>Marcar como completada</span>
												</label>
											</form>
										</div>
									}
								}
							</div>
						</div>

						<!-- Acordeón de Tareas Completadas -->
						<details class="completed-accordion">
							<summary class="completed-summary">
								<span class="summary-left">
									<i class="fa-solid fa-chevron-right"></i>
									<span>Tareas Completadas</span>
								</span>
								<span class="summary-pill">{ fmt.Sprint(len(tareasCompletadas(m.Tareas))) }</span>
							</summary>
							<div class="completed-list">
								if len(tareasCompletadas(m.Tareas)) == 0 {
									<span style="color: var(--color-text-dim);">No hay tareas completadas aún.</span>
								} else {
									for _, tc := range tareasCompletadas(m.Tareas) {
										<div class="completed-item" style="display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;">
											<span>
												<i class="fa-solid fa-check" style="color: var(--color-green); margin-right: 0.35rem;"></i>
												<span>{ tc.Titulo }</span>
											</span>
											<span style="display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none;">
												<a
													href={ templ.URL(fmt.Sprintf("#edit-task-%d", tc.IDTarea)) }
													title="Editar tarea"
													style="color: var(--color-text-muted); font-size: 0.72rem; text-decoration: none;"
												>
													<i class="fa-solid fa-pen"></i>
												</a>
												<button
													type="button"
													hx-delete={ fmt.Sprintf("/tareas/%d", tc.IDTarea) }
													hx-target="#main-content"
													hx-swap="innerHTML"
													hx-confirm="¿Eliminar esta tarea completada?"
													title="Eliminar tarea"
													style="background: transparent; border: none; color: #f87171; cursor: pointer; font-size: 0.72rem; padding: 0;"
												>
													<i class="fa-solid fa-trash-can"></i>
												</button>
											</span>
										</div>
									}
								}
							</div>
						</details>
					</article>
				}
			</div>
		</section>
	}

	<!-- MODAL: AGREGAR MATERIA (#materia-modal) -->
	<div id="materia-modal" class="modal">
		<div class="modal-content">
			<a href="#" class="modal-close-btn" title="Cerrar">&times;</a>
			<header class="modal-header">
				<i class="fa-solid fa-folder-plus"></i>
				<span>Nueva Materia</span>
			</header>
			<form
				action="/materias"
				method="POST"
				hx-post="/materias"
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-on::after-request="if(event.detail.successful) history.replaceState(null, '', '/materias');"
				class="modal-form"
			>
				<div class="form-group">
					<label for="materia-titulo" class="form-label">
						Nombre de la Materia <span class="req-star">*</span>
					</label>
					<input
						type="text"
						id="materia-titulo"
						name="titulo"
						required
						placeholder="Ej: Programación Web"
						class="form-control"
					/>
				</div>
				<div class="modal-footer">
					<a href="#" class="btn btn-outline">Cancelar</a>
					<button type="submit" class="btn btn-primary">
						<i class="fa-solid fa-floppy-disk"></i>
						<span>Guardar Materia</span>
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- MODAL: AGREGAR TAREA (#task-modal) -->
	<div id="task-modal" class="modal">
		<div class="modal-content">
			<a href="#" class="modal-close-btn" title="Cerrar">&times;</a>
			<header class="modal-header">
				<i class="fa-solid fa-plus-circle"></i>
				<span>Nueva Tarea</span>
			</header>
			<form
				action="/tareas"
				method="POST"
				hx-post="/tareas"
				hx-target="#main-content"
				hx-swap="innerHTML"
				hx-on::after-request="if(event.detail.successful) history.replaceState(null, '', '/materias');"
				class="modal-form"
			>
				<div class="form-group">
					<label for="tarea-materia" class="form-label">
						Materia <span class="req-star">*</span>
					</label>
					<select id="tarea-materia" name="id_lista" required class="form-control">
						if len(materias) == 0 {
							<option value="">Primero debes crear una materia</option>
						} else {
							<option value="">Seleccionar materia...</option>
							for _, m := range materias {
								<option value={ fmt.Sprint(m.Materia.IDLista) }>{ m.Materia.Titulo }</option>
							}
						}
					</select>
				</div>

				<div class="form-group">
					<label for="tarea-titulo" class="form-label">
						Título de la Tarea <span class="req-star">*</span>
					</label>
					<input
						type="text"
						id="tarea-titulo"
						name="titulo"
						required
						placeholder="Ej: Terminar vistas templ"
						class="form-control"
					/>
				</div>

				<div class="form-group">
					<label for="tarea-desc" class="form-label">Descripción</label>
					<textarea
						id="tarea-desc"
						name="descripcion"
						rows="2"
						placeholder="Detalles opcionales de la tarea..."
						class="form-control"
					></textarea>
				</div>

				<div class="form-grid-4" style="grid-template-columns: 1fr; gap: 0.75rem;">
					<div class="form-group">
						<label for="tarea-inicio" class="form-label">Fecha Inicio</label>
						<input type="datetime-local" id="tarea-inicio" name="fecha_inicio" class="form-control"/>
					</div>
					<div class="form-group">
						<label for="tarea-fin" class="form-label">Fecha Entrega</label>
						<input type="datetime-local" id="tarea-fin" name="fecha_finalizacion" class="form-control"/>
					</div>
				</div>

				<div class="modal-footer">
					<a href="#" class="btn btn-outline">Cancelar</a>
					<button type="submit" class="btn btn-primary" disabled?={ len(materias) == 0 }>
						<i class="fa-solid fa-floppy-disk"></i>
						<span>Guardar Tarea</span>
					</button>
				</div>
			</form>
		</div>
	</div>

	<!-- MODALES: EDITAR MATERIA (#edit-materia-{id}) Y EDITAR TAREA (#edit-task-{id}) -->
	for _, m := range materias {
		<div id={ fmt.Sprintf("edit-materia-%d", m.Materia.IDLista) } class="modal">
			<div class="modal-content">
				<a href="#" class="modal-close-btn" title="Cerrar">&times;</a>
				<header class="modal-header">
					<i class="fa-solid fa-pen-to-square"></i>
					<span>Editar Materia</span>
				</header>
				<form
					hx-put={ fmt.Sprintf("/materias/%d", m.Materia.IDLista) }
					hx-target="#main-content"
					hx-swap="innerHTML"
					hx-on::after-request="if(event.detail.successful) history.replaceState(null, '', '/materias');"
					class="modal-form"
				>
					<div class="form-group">
						<label for={ fmt.Sprintf("edit-materia-titulo-%d", m.Materia.IDLista) } class="form-label">
							Nombre de la Materia <span class="req-star">*</span>
						</label>
						<input
							type="text"
							id={ fmt.Sprintf("edit-materia-titulo-%d", m.Materia.IDLista) }
							name="titulo"
							value={ m.Materia.Titulo }
							required
							class="form-control"
						/>
					</div>
					<div class="modal-footer">
						<a href="#" class="btn btn-outline">Cancelar</a>
						<button type="submit" class="btn btn-primary">
							<i class="fa-solid fa-floppy-disk"></i>
							<span>Guardar Cambios</span>
						</button>
					</div>
				</form>
			</div>
		</div>

		for _, t := range m.Tareas {
			<div id={ fmt.Sprintf("edit-task-%d", t.IDTarea) } class="modal">
				<div class="modal-content">
					<a href="#" class="modal-close-btn" title="Cerrar">&times;</a>
					<header class="modal-header">
						<i class="fa-solid fa-pen-to-square"></i>
						<span>Editar Tarea</span>
					</header>
					<form
						hx-put={ fmt.Sprintf("/tareas/%d", t.IDTarea) }
						hx-target="#main-content"
						hx-swap="innerHTML"
						hx-on::after-request="if(event.detail.successful) history.replaceState(null, '', '/materias');"
						class="modal-form"
					>
						<div class="form-group">
							<label for={ fmt.Sprintf("edit-tarea-titulo-%d", t.IDTarea) } class="form-label">
								Título de la Tarea <span class="req-star">*</span>
							</label>
							<input
								type="text"
								id={ fmt.Sprintf("edit-tarea-titulo-%d", t.IDTarea) }
								name="titulo"
								value={ t.Titulo }
								required
								class="form-control"
							/>
						</div>

						<div class="form-group">
							<label for={ fmt.Sprintf("edit-tarea-desc-%d", t.IDTarea) } class="form-label">Descripción</label>
							<textarea
								id={ fmt.Sprintf("edit-tarea-desc-%d", t.IDTarea) }
								name="descripcion"
								rows="2"
								class="form-control"
							>{ t.Descripcion.String }</textarea>
						</div>

						<div class="form-grid-4" style="grid-template-columns: 1fr; gap: 0.75rem;">
							<div class="form-group">
								<label for={ fmt.Sprintf("edit-tarea-inicio-%d", t.IDTarea) } class="form-label">Fecha Inicio</label>
								<input
									type="datetime-local"
									id={ fmt.Sprintf("edit-tarea-inicio-%d", t.IDTarea) }
									name="fecha_inicio"
									value={ formatFechaInput(t.FechaInicio) }
									class="form-control"
								/>
							</div>
							<div class="form-group">
								<label for={ fmt.Sprintf("edit-tarea-fin-%d", t.IDTarea) } class="form-label">Fecha Entrega</label>
								<input
									type="datetime-local"
									id={ fmt.Sprintf("edit-tarea-fin-%d", t.IDTarea) }
									name="fecha_finalizacion"
									value={ formatFechaInput(t.FechaFinalizacion) }
									class="form-control"
								/>
							</div>
						</div>

						<label class="checklist-label" style="margin-top: 0.25rem;">
							<input
								type="checkbox"
								name="completada"
								checked?={ t.Completada }
								class="checklist-input"
							/>
							<span>Tarea completada</span>
						</label>

						<div class="modal-footer">
							<a href="#" class="btn btn-outline">Cancelar</a>
							<button type="submit" class="btn btn-primary">
								<i class="fa-solid fa-floppy-disk"></i>
								<span>Guardar Cambios</span>
							</button>
						</div>
					</form>
				</div>
			</div>
		}
	}
}

templ MateriasPage(usuario db.Usuario, materias []MateriaConTareas) {
	@LayoutBase("go_tasks - Materias", usuario.Nombre, "materias") {
		@MateriasContent(materias)
	}
}
